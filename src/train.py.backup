import os

# Limit CPU-side numerical library threads before imports.
os.environ["OMP_NUM_THREADS"] = "1"
os.environ["MKL_NUM_THREADS"] = "1"
os.environ["OPENBLAS_NUM_THREADS"] = "1"
os.environ["VECLIB_MAXIMUM_THREADS"] = "1"

import argparse
import random
from pathlib import Path

import cv2
import numpy as np
import torch
from torch import nn
from torch.utils.data import DataLoader
from tqdm.auto import tqdm

from models.segmentation_cnn import SegmentationCNN
from src.dataset import DUTSDataset
from src.splits import split_dataset


def set_seed(seed: int) -> None:
    """Set random seeds for reproducible experiments."""
    random.seed(seed)
    np.random.seed(seed)
    torch.manual_seed(seed)

    if torch.cuda.is_available():
        torch.cuda.manual_seed_all(seed)


def select_device(device_arg: str) -> torch.device:
    """Select CPU, CUDA, or automatically detect the device."""
    if device_arg == "auto":
        return torch.device(
            "cuda" if torch.cuda.is_available() else "cpu"
        )

    if device_arg == "cuda":
        if not torch.cuda.is_available():
            raise RuntimeError(
                "CUDA is unavailable. Check the NVIDIA driver "
                "and your PyTorch installation."
            )
        return torch.device("cuda")

    return torch.device("cpu")


def create_loaders(
    data_root: str,
    batch_size: int,
    seed: int,
    workers: int,
    limit: int | None = None,
    pin_memory: bool = False,
):
    """Create deterministic training and validation data loaders."""
    dataset = DUTSDataset(data_root, split="DUTS-TR")

    if limit is not None:
        if limit < 2:
            raise ValueError("--limit must be at least 2")

        dataset = torch.utils.data.Subset(
            dataset,
            range(min(limit, len(dataset))),
        )

    train_set, val_set = split_dataset(
        dataset,
        validation_fraction=0.1,
        seed=seed,
    )

    common_options = {
        "batch_size": batch_size,
        "num_workers": workers,
        "pin_memory": pin_memory,
        "persistent_workers": workers > 0,
    }

    if workers > 0:
        common_options["prefetch_factor"] = 2

    train_loader = DataLoader(
        train_set,
        shuffle=True,
        **common_options,
    )

    val_loader = DataLoader(
        val_set,
        shuffle=False,
        **common_options,
    )

    return train_loader, val_loader


def run_epoch(
    model: nn.Module,
    loader: DataLoader,
    criterion: nn.Module,
    device: torch.device,
    optimizer: torch.optim.Optimizer | None = None,
    scaler=None,
    use_amp: bool = False,
    channels_last: bool = False,
    epoch: int = 0,
    total_epochs: int = 0,
    log_interval: int = 25,
) -> float:
    """Run a training or validation epoch with optimized GPU execution."""
    training = optimizer is not None
    model.train(training)

    total_samples = 0
    running_loss = torch.zeros((), device=device)

    phase = "Train" if training else "Valid"

    progress = tqdm(
        loader,
        desc=f"Epoch {epoch}/{total_epochs} [{phase}]",
        unit="batch",
        dynamic_ncols=True,
        leave=True,
    )

    for step, (images, masks) in enumerate(progress, start=1):
        images = images.to(
            device,
            non_blocking=(device.type == "cuda"),
        )
        masks = masks.to(
            device,
            non_blocking=(device.type == "cuda"),
        )

        if channels_last:
            images = images.contiguous(
                memory_format=torch.channels_last
            )

        if training:
            optimizer.zero_grad(set_to_none=True)

        with torch.set_grad_enabled(training):
            with torch.amp.autocast(
                device_type=device.type,
                dtype=torch.float16,
                enabled=use_amp,
            ):
                logits = model(images)
                loss = criterion(logits, masks)

            if training:
                if use_amp:
                    scaler.scale(loss).backward()
                    scaler.step(optimizer)
                    scaler.update()
                else:
                    loss.backward()
                    optimizer.step()

        batch_size = images.shape[0]

        # Accumulate loss on the current device. Avoid loss.item()
        # on every batch because it synchronizes the CUDA stream.
        running_loss.add_(loss.detach() * batch_size)
        total_samples += batch_size

        # Update tqdm periodically rather than synchronizing each batch.
        if step % log_interval == 0 or step == len(loader):
            average_loss = (
                running_loss / total_samples
            ).item()

            progress.set_postfix(
                loss=f"{average_loss:.4f}",
                samples=f"{total_samples}/{len(loader.dataset)}",
            )

    progress.close()

    if total_samples == 0:
        raise RuntimeError("DataLoader produced no samples")

    return (running_loss / total_samples).item()


def save_checkpoint(
    model: nn.Module,
    checkpoint_path: Path,
    epoch: int,
    train_loss: float,
    val_loss: float,
    seed: int,
) -> None:
    """Save the best checkpoint with model weights on the CPU."""
    cpu_state_dict = {
        key: value.detach().cpu()
        for key, value in model.state_dict().items()
    }

    torch.save(
        {
            "model_state_dict": cpu_state_dict,
            "epoch": epoch,
            "train_loss": train_loss,
            "val_loss": val_loss,
            "seed": seed,
            "architecture": "SegmentationCNN",
        },
        checkpoint_path,
    )


def train(args) -> None:
    """Train the model and save the checkpoint with lowest validation loss."""
    set_seed(args.seed)

    device = select_device(args.device)
    use_amp = device.type == "cuda" and args.amp
    channels_last = device.type == "cuda" and args.channels_last

    torch.set_num_threads(1)
    cv2.setNumThreads(1)

    if device.type == "cuda":
        # Fixed input resolution makes convolution benchmarking useful.
        torch.backends.cudnn.benchmark = True
        torch.cuda.reset_peak_memory_stats(device)

    train_loader, val_loader = create_loaders(
        data_root=args.data,
        batch_size=args.batch_size,
        seed=args.seed,
        workers=args.workers,
        limit=args.limit,
        pin_memory=(device.type == "cuda"),
    )

    model = SegmentationCNN().to(device)

    if channels_last:
        model = model.to(memory_format=torch.channels_last)

    criterion = nn.BCEWithLogitsLoss()

    optimizer = torch.optim.Adam(
        model.parameters(),
        lr=args.learning_rate,
    )

    # Mixed-precision gradient scaling helps prevent FP16 gradient underflow.
    scaler = torch.amp.GradScaler(
        "cuda",
        enabled=use_amp,
    )

    checkpoint_path = Path(args.checkpoint)
    checkpoint_path.parent.mkdir(parents=True, exist_ok=True)

    best_val_loss = float("inf")
    best_epoch = 0

    print("=" * 64)
    print("SALIENT OBJECT SEGMENTATION TRAINING")
    print("=" * 64)
    print(f"Device:              {device}")

    if device.type == "cuda":
        print(f"GPU:                 {torch.cuda.get_device_name(0)}")

    print(f"Mixed precision:     {use_amp}")
    print(f"Channels last:       {channels_last}")
    print(f"Data workers:        {args.workers}")
    print(f"Training samples:    {len(train_loader.dataset)}")
    print(f"Validation samples:  {len(val_loader.dataset)}")
    print(f"Batch size:          {args.batch_size}")
    print(f"Epochs:              {args.epochs}")
    print(f"Learning rate:       {args.learning_rate}")
    print(f"Checkpoint:          {checkpoint_path}")
    print("=" * 64)

    for epoch in range(1, args.epochs + 1):
        train_loss = run_epoch(
            model=model,
            loader=train_loader,
            criterion=criterion,
            device=device,
            optimizer=optimizer,
            scaler=scaler,
            use_amp=use_amp,
            channels_last=channels_last,
            epoch=epoch,
            total_epochs=args.epochs,
            log_interval=args.log_interval,
        )

        # Validation uses the same precision setting as training.
        # Evaluation for the assignment will still run separately on CPU.
        with torch.no_grad():
            val_loss = run_epoch(
                model=model,
                loader=val_loader,
                criterion=criterion,
                device=device,
                scaler=scaler,
                use_amp=use_amp,
                channels_last=channels_last,
                epoch=epoch,
                total_epochs=args.epochs,
                log_interval=args.log_interval,
            )

        print(
            f"\nEpoch {epoch:02d}/{args.epochs:02d} | "
            f"Train Loss: {train_loss:.6f} | "
            f"Validation Loss: {val_loss:.6f}"
        )

        if val_loss < best_val_loss:
            best_val_loss = val_loss
            best_epoch = epoch

            save_checkpoint(
                model=model,
                checkpoint_path=checkpoint_path,
                epoch=epoch,
                train_loss=train_loss,
                val_loss=val_loss,
                seed=args.seed,
            )

            print(f"Saved best checkpoint: {checkpoint_path}")

        print()

    print("=" * 64)
    print("TRAINING COMPLETE")
    print("=" * 64)
    print(f"Best epoch:           {best_epoch}")
    print(f"Best validation loss: {best_val_loss:.6f}")
    print(f"Checkpoint:           {checkpoint_path}")

    if device.type == "cuda":
        peak_memory_mb = (
            torch.cuda.max_memory_allocated(device) / (1024**2)
        )
        print(f"Peak GPU memory:      {peak_memory_mb:.1f} MiB")

    print("=" * 64)


def parse_args():
    """Parse and validate command-line arguments."""
    parser = argparse.ArgumentParser(
        description="Train a lightweight segmentation CNN."
    )

    parser.add_argument("--data", type=str, default="data")
    parser.add_argument(
        "--checkpoint",
        type=str,
        default="checkpoints/best.pt",
    )
    parser.add_argument("--epochs", type=int, default=10)
    parser.add_argument("--batch-size", type=int, default=16)
    parser.add_argument("--learning-rate", type=float, default=1e-3)
    parser.add_argument("--seed", type=int, default=42)

    parser.add_argument(
        "--device",
        choices=["auto", "cpu", "cuda"],
        default="auto",
    )

    parser.add_argument(
        "--workers",
        type=int,
        default=2,
        help="Number of CPU workers for image loading.",
    )

    parser.add_argument(
        "--limit",
        type=int,
        default=None,
        help="Limit dataset size for smoke tests.",
    )

    parser.add_argument(
        "--log-interval",
        type=int,
        default=25,
        help="Update progress-bar loss every N batches.",
    )

    parser.add_argument(
        "--amp",
        action=argparse.BooleanOptionalAction,
        default=True,
        help="Enable CUDA automatic mixed precision when available.",
    )

    parser.add_argument(
        "--channels-last",
        action=argparse.BooleanOptionalAction,
        default=True,
        help="Use channels-last memory format on CUDA.",
    )

    args = parser.parse_args()

    if args.epochs < 1:
        parser.error("--epochs must be at least 1")
    if args.batch_size < 1:
        parser.error("--batch-size must be at least 1")
    if args.learning_rate <= 0:
        parser.error("--learning-rate must be positive")
    if args.workers < 0:
        parser.error("--workers cannot be negative")
    if args.log_interval < 1:
        parser.error("--log-interval must be at least 1")
    if args.limit is not None and args.limit < 2:
        parser.error("--limit must be at least 2")

    return args


if __name__ == "__main__":
    train(parse_args())
