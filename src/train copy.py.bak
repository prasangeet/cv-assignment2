import os

# Set thread limits before importing numerical libraries.
os.environ["OMP_NUM_THREADS"] = "1"
os.environ["MKL_NUM_THREADS"] = "1"
os.environ["OPENBLAS_NUM_THREADS"] = "1"
os.environ["VECLIB_MAXIMUM_THREADS"] = "1"
os.environ["TRITON_DEFAULT_FP_FUSION"] = "1"

import argparse
import csv
import json
import random
import time
from pathlib import Path

import cv2
import matplotlib

matplotlib.use("Agg")

import matplotlib.pyplot as plt
import numpy as np
import torch
from torch import nn
from torch.utils.data import DataLoader
from tqdm.auto import tqdm

from models.segmentation_cnn import SegmentationCNN
from src.dataset import DUTSDataset
from src.splits import split_dataset


HISTORY_FIELDS = [
    "epoch",
    "train_loss",
    "val_loss",
    "learning_rate",
    "epoch_seconds",
    "train_seconds",
    "validation_seconds",
    "peak_gpu_memory_mb",
]


class HybridBCEDiceLoss(nn.Module):
    """Combines BCEWithLogitsLoss and Soft IoU Loss for superior segmentation accuracy."""
    def __init__(self, bce_weight: float = 0.5, smooth: float = 1e-6):
        super().__init__()
        self.bce = nn.BCEWithLogitsLoss()
        self.bce_weight = bce_weight
        self.smooth = smooth

    def forward(self, logits: torch.Tensor, targets: torch.Tensor) -> torch.Tensor:
        bce_loss = self.bce(logits, targets)

        probs = torch.sigmoid(logits)
        intersection = (probs * targets).sum(dim=(1, 2, 3))
        union = probs.sum(dim=(1, 2, 3)) + targets.sum(dim=(1, 2, 3)) - intersection
        iou = (intersection + self.smooth) / (union + self.smooth)
        iou_loss = (1.0 - iou).mean()

        return self.bce_weight * bce_loss + (1.0 - self.bce_weight) * iou_loss


def set_seed(seed: int) -> None:
    random.seed(seed)
    np.random.seed(seed)
    torch.manual_seed(seed)
    if torch.cuda.is_available():
        torch.cuda.manual_seed_all(seed)


def select_device(device_arg: str) -> torch.device:
    if device_arg == "auto":
        return torch.device("cuda" if torch.cuda.is_available() else "cpu")
    if device_arg == "cuda":
        if not torch.cuda.is_available():
            raise RuntimeError("CUDA is unavailable.")
        return torch.device("cuda")
    return torch.device("cpu")


def create_loaders(
    data_root: str,
    batch_size: int,
    seed: int,
    workers: int,
    limit: int | None = None,
    pin_memory: bool = False,
):
    dataset = DUTSDataset(data_root, split="DUTS-TE")

    if limit is not None:
        if limit < 2:
            raise ValueError("--limit must be at least 2")
        dataset = torch.utils.data.Subset(
            dataset,
            range(min(limit, len(dataset))),
        )

    train_set, val_set = split_dataset(
        dataset,
        validation_fraction=0.1,
        seed=seed,
    )

    common_options = {
        "batch_size": batch_size,
        "num_workers": workers,
        "pin_memory": pin_memory,
        "persistent_workers": workers > 0,
    }

    if workers > 0:
        common_options["prefetch_factor"] = 2

    train_loader = DataLoader(train_set, shuffle=True, **common_options)
    val_loader = DataLoader(val_set, shuffle=False, **common_options)

    return train_loader, val_loader


def run_epoch(
    model: nn.Module,
    loader: DataLoader,
    criterion: nn.Module,
    device: torch.device,
    optimizer=None,
    scaler=None,
    scheduler=None,
    use_amp: bool = False,
    channels_last: bool = False,
    epoch: int = 0,
    total_epochs: int = 0,
    log_interval: int = 25,
    accumulation_steps: int = 1,
) -> float:
    training = optimizer is not None
    model.train(training)

    total_samples = 0
    running_loss = torch.zeros((), device=device)

    phase = "Train" if training else "Valid"

    progress = tqdm(
        loader,
        desc=f"Epoch {epoch}/{total_epochs} [{phase}]",
        unit="batch",
        dynamic_ncols=True,
        leave=True,
    )

    if training:
        optimizer.zero_grad(set_to_none=True)

    for step, (images, masks) in enumerate(progress, start=1):
        images = images.to(device, non_blocking=(device.type == "cuda"))
        masks = masks.to(device, non_blocking=(device.type == "cuda"))

        if training:
            if torch.rand(1).item() > 0.5:
                images = torch.flip(images, dims=[3])
                masks = torch.flip(masks, dims=[3])

        if channels_last:
            images = images.contiguous(memory_format=torch.channels_last)

        with torch.set_grad_enabled(training):
            with torch.amp.autocast(
                device_type=device.type,
                dtype=torch.float16,
                enabled=use_amp,
            ):
                logits = model(images)
                loss = criterion(logits, masks)

                if training:
                    loss = loss / accumulation_steps

            if training:
                if use_amp:
                    scaler.scale(loss).backward()
                    if step % accumulation_steps == 0 or step == len(loader):
                        scaler.unscale_(optimizer)
                        torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=2.0)
                        scaler.step(optimizer)
                        scaler.update()
                        optimizer.zero_grad(set_to_none=True)

                        if scheduler is not None:
                            scheduler.step()
                else:
                    loss.backward()
                    if step % accumulation_steps == 0 or step == len(loader):
                        torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=2.0)
                        optimizer.step()
                        optimizer.zero_grad(set_to_none=True)

                        if scheduler is not None:
                            scheduler.step()

        batch_size = images.shape[0]
        actual_loss = loss.detach() * (accumulation_steps if training else 1.0)
        running_loss.add_(actual_loss * batch_size)
        total_samples += batch_size

        if step % log_interval == 0 or step == len(loader):
            average_loss = (running_loss / total_samples).item()
            current_lr = optimizer.param_groups[0]["lr"] if optimizer else 0.0

            progress.set_postfix(
                loss=f"{average_loss:.5f}",
                lr=f"{current_lr:.2e}",
                samples=f"{total_samples}/{len(loader.dataset)}",
            )

    progress.close()

    if total_samples == 0:
        raise RuntimeError("DataLoader produced no samples.")

    return (running_loss / total_samples).item()


def save_checkpoint(
    path: Path,
    model: nn.Module,
    optimizer,
    scaler,
    epoch: int,
    train_loss: float,
    val_loss: float,
    seed: int,
    best_val_loss: float,
    best_epoch: int,
    config: dict,
    scheduler=None,
) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)

    model_state = model._orig_mod.state_dict() if hasattr(model, '_orig_mod') else model.state_dict()

    checkpoint = {
        "model_state_dict": {
            key: value.detach().cpu()
            for key, value in model_state.items()
        },
        "optimizer_state_dict": optimizer.state_dict(),
        "scaler_state_dict": scaler.state_dict() if scaler else None,
        "scheduler_state_dict": scheduler.state_dict() if scheduler else None,
        "epoch": epoch,
        "train_loss": train_loss,
        "val_loss": val_loss,
        "seed": seed,
        "best_val_loss": best_val_loss,
        "best_epoch": best_epoch,
        "python_rng_state": random.getstate(),
        "numpy_rng_state": np.random.get_state(),
        "torch_rng_state": torch.get_rng_state(),
        "cuda_rng_state_all": (
            torch.cuda.get_rng_state_all() if torch.cuda.is_available() else None
        ),
        "architecture": "SegmentationCNN",
        "config": config,
    }
    torch.save(checkpoint, path)


def save_history(history: list[dict], output_dir: Path) -> None:
    output_dir.mkdir(parents=True, exist_ok=True)
    csv_path = output_dir / "history.csv"
    json_path = output_dir / "history.json"

    with csv_path.open("w", newline="", encoding="utf-8") as file:
        writer = csv.DictWriter(file, fieldnames=HISTORY_FIELDS)
        writer.writeheader()
        writer.writerows(history)

    with json_path.open("w", encoding="utf-8") as file:
        json.dump(history, file, indent=2)


def save_config(config: dict, output_dir: Path) -> None:
    output_dir.mkdir(parents=True, exist_ok=True)
    with (output_dir / "config.json").open("w", encoding="utf-8") as file:
        json.dump(config, file, indent=2)


def save_plots(history: list[dict], output_dir: Path) -> None:
    if not history:
        return

    output_dir.mkdir(parents=True, exist_ok=True)

    epochs = [row["epoch"] for row in history]
    train_losses = [row["train_loss"] for row in history]
    val_losses = [row["val_loss"] for row in history]
    learning_rates = [row["learning_rate"] for row in history]

    fig, ax = plt.subplots(figsize=(9, 6))
    ax.plot(epochs, train_losses, marker="o", label="Training loss")
    ax.plot(epochs, val_losses, marker="o", label="Validation loss")
    ax.set_xlabel("Epoch")
    ax.set_ylabel("Loss")
    ax.set_title("Training and Validation Loss")
    ax.grid(True, alpha=0.3)
    ax.legend()
    fig.tight_layout()
    fig.savefig(output_dir / "loss_curve.png", dpi=160)
    plt.close(fig)

    fig, ax = plt.subplots(figsize=(9, 5))
    ax.plot(epochs, learning_rates, marker="o")
    ax.set_xlabel("Epoch")
    ax.set_ylabel("Learning rate")
    ax.set_title("Learning Rate Schedule")
    ax.grid(True, alpha=0.3)
    fig.tight_layout()
    fig.savefig(output_dir / "learning_rate.png", dpi=160)
    plt.close(fig)


def save_summary(
    history: list[dict],
    output_dir: Path,
    best_epoch: int,
    best_val_loss: float,
    checkpoint_path: Path,
    latest_checkpoint_path: Path,
) -> None:
    if not history:
        return

    summary = {
        "epochs_recorded": len(history),
        "best_epoch": best_epoch,
        "best_validation_loss": best_val_loss,
        "last_epoch": history[-1]["epoch"],
        "last_training_loss": history[-1]["train_loss"],
        "last_validation_loss": history[-1]["val_loss"],
        "best_checkpoint": str(checkpoint_path),
        "latest_checkpoint": str(latest_checkpoint_path),
    }

    with (output_dir / "summary.json").open("w", encoding="utf-8") as file:
        json.dump(summary, file, indent=2)


def load_history(path: Path) -> list[dict]:
    if not path.exists():
        return []

    with path.open("r", newline="", encoding="utf-8") as file:
        reader = csv.DictReader(file)
        rows = []
        for row in reader:
            converted = {
                "epoch": int(row["epoch"]),
                "train_loss": float(row["train_loss"]),
                "val_loss": float(row["val_loss"]),
                "learning_rate": float(row["learning_rate"]),
                "epoch_seconds": float(row["epoch_seconds"]),
                "train_seconds": float(row["train_seconds"]),
                "validation_seconds": float(row["validation_seconds"]),
                "peak_gpu_memory_mb": float(row["peak_gpu_memory_mb"]),
            }
            rows.append(converted)
        return rows


def restore_rng_state(checkpoint: dict) -> None:
    if "python_rng_state" in checkpoint:
        random.setstate(checkpoint["python_rng_state"])
    if "numpy_rng_state" in checkpoint:
        np.random.set_state(checkpoint["numpy_rng_state"])
    if "torch_rng_state" in checkpoint:
        torch.set_rng_state(checkpoint["torch_rng_state"])

    cuda_state = checkpoint.get("cuda_rng_state_all")
    if cuda_state is not None and torch.cuda.is_available():
        try:
            torch.cuda.set_rng_state_all(cuda_state)
        except (RuntimeError, ValueError):
            pass


def train(args) -> None:
    set_seed(args.seed)

    device = select_device(args.device)
    use_amp = device.type == "cuda" and args.amp
    channels_last = device.type == "cuda" and args.channels_last

    torch.set_num_threads(1)
    cv2.setNumThreads(1)

    if device.type == "cuda":
        torch.backends.cudnn.benchmark = True
        torch.backends.cuda.matmul.allow_tf32 = True
        torch.backends.cudnn.allow_tf32 = True
        torch.cuda.reset_peak_memory_stats(device)

    output_dir = Path(args.output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)

    # Store checkpoints directly inside the specified output directory
    checkpoint_path = output_dir / Path(args.checkpoint).name
    latest_checkpoint_path = output_dir / Path(args.latest_checkpoint).name

    train_loader, val_loader = create_loaders(
        data_root=args.data,
        batch_size=args.batch_size,
        seed=args.seed,
        workers=args.workers,
        limit=args.limit,
        pin_memory=(device.type == "cuda"),
    )

    model = SegmentationCNN().to(device)

    if channels_last:
        model = model.to(memory_format=torch.channels_last)

    if args.compile and hasattr(torch, "compile"):
        print("Compiling model with torch.compile()...")
        model = torch.compile(model, mode="default")

    # Use Hybrid Loss (BCE + Soft IoU)
    criterion = HybridBCEDiceLoss(bce_weight=0.5)

    optimizer = torch.optim.AdamW(
        model.parameters(),
        lr=args.learning_rate,
        weight_decay=args.weight_decay,
    )

    effective_steps_per_epoch = (len(train_loader) + args.accumulation_steps - 1) // args.accumulation_steps
    scheduler = torch.optim.lr_scheduler.OneCycleLR(
        optimizer,
        max_lr=args.learning_rate,
        epochs=args.epochs,
        steps_per_epoch=effective_steps_per_epoch,
        pct_start=0.3,
        div_factor=10.0,
        final_div_factor=100.0,
    )

    scaler = torch.amp.GradScaler("cuda", enabled=use_amp)

    config = {
        "data": args.data,
        "epochs_requested": args.epochs,
        "batch_size": args.batch_size,
        "accumulation_steps": args.accumulation_steps,
        "effective_batch_size": args.batch_size * args.accumulation_steps,
        "learning_rate": args.learning_rate,
        "weight_decay": args.weight_decay,
        "seed": args.seed,
        "device": str(device),
        "mixed_precision": use_amp,
        "channels_last": channels_last,
        "compile_enabled": args.compile,
        "workers": args.workers,
        "limit": args.limit,
        "validation_fraction": 0.1,
        "scheduler": "OneCycleLR",
        "architecture": "SegmentationCNN",
        "loss": "HybridBCEDiceLoss",
    }

    history_path = output_dir / "history.csv"
    history = []
    start_epoch = 1
    best_val_loss = float("inf")
    best_epoch = 0

    if args.resume:
        resume_path = Path(args.resume_from)
        if not resume_path.exists():
            raise FileNotFoundError(f"Cannot resume: checkpoint not found: {resume_path}")

        print(f"Resuming from checkpoint: {resume_path}")
        checkpoint = torch.load(resume_path, map_location="cpu", weights_only=False)

        model_state = checkpoint["model_state_dict"]
        if hasattr(model, '_orig_mod'):
            model._orig_mod.load_state_dict(model_state)
        else:
            model.load_state_dict(model_state)

        if "optimizer_state_dict" in checkpoint:
            optimizer.load_state_dict(checkpoint["optimizer_state_dict"])
        if "scaler_state_dict" in checkpoint and checkpoint["scaler_state_dict"]:
            scaler.load_state_dict(checkpoint["scaler_state_dict"])
        if "scheduler_state_dict" in checkpoint and checkpoint["scheduler_state_dict"]:
            scheduler.load_state_dict(checkpoint["scheduler_state_dict"])

        restore_rng_state(checkpoint)

        start_epoch = int(checkpoint["epoch"]) + 1
        best_val_loss = float(checkpoint.get("best_val_loss", checkpoint["val_loss"]))
        best_epoch = int(checkpoint.get("best_epoch", checkpoint["epoch"]))
        history = load_history(history_path)

        if history and history[-1]["epoch"] >= start_epoch:
            history = [row for row in history if row["epoch"] < start_epoch]

        print(f"Resuming at epoch {start_epoch}")
    else:
        if history_path.exists() and not args.overwrite_history:
            raise FileExistsError(
                f"History already exists at {history_path}.\n"
                "Use --resume to continue an experiment, or "
                "--overwrite-history to start a fresh run."
            )

        if args.overwrite_history:
            for name in (
                "history.csv", "history.json", "loss_curve.png",
                "learning_rate.png", "summary.json", "model_best.pt", "model_latest.pt",
            ):
                file_path = output_dir / name
                if file_path.exists():
                    file_path.unlink()

    save_config(config, output_dir)

    print("=" * 68)
    print("SALIENT OBJECT SEGMENTATION TRAINING")
    print("=" * 68)
    print(f"Device:                 {device}")
    if device.type == "cuda":
        print(f"GPU:                    {torch.cuda.get_device_name(0)}")
    print(f"Torch Compile:          {args.compile}")
    print(f"Mixed precision:        {use_amp}")
    print(f"Channels last:          {channels_last}")
    print(f"Data workers:           {args.workers}")
    print(f"Training samples:       {len(train_loader.dataset)}")
    print(f"Validation samples:     {len(val_loader.dataset)}")
    print(f"Micro-Batch size:       {args.batch_size}")
    print(f"Accumulation steps:     {args.accumulation_steps}")
    print(f"Effective Batch Size:   {args.batch_size * args.accumulation_steps}")
    print(f"Requested total epochs: {args.epochs}")
    print(f"Starting epoch:         {start_epoch}")
    print(f"Peak learning rate:     {args.learning_rate}")
    print(f"Scheduler:              OneCycleLR (Warmup & Anneal)")
    print(f"Optimizer:              AdamW")
    print(f"Loss Function:          Hybrid (BCE + Soft IoU)")
    print(f"Experiment output:      {output_dir}")
    print(f"Best Checkpoint target: {checkpoint_path}")
    print("=" * 68)

    if start_epoch > args.epochs:
        print(f"Checkpoint already reached epoch {start_epoch - 1}; requested total epochs: {args.epochs}.")
        return

    try:
        for epoch in range(start_epoch, args.epochs + 1):
            epoch_start = time.perf_counter()

            if device.type == "cuda":
                torch.cuda.reset_peak_memory_stats(device)

            train_start = time.perf_counter()

            train_loss = run_epoch(
                model=model,
                loader=train_loader,
                criterion=criterion,
                device=device,
                optimizer=optimizer,
                scaler=scaler,
                scheduler=scheduler,
                use_amp=use_amp,
                channels_last=channels_last,
                epoch=epoch,
                total_epochs=args.epochs,
                log_interval=args.log_interval,
                accumulation_steps=args.accumulation_steps,
            )

            if device.type == "cuda":
                torch.cuda.synchronize(device)

            train_seconds = time.perf_counter() - train_start

            if device.type == "cuda":
                torch.cuda.empty_cache()

            validation_start = time.perf_counter()

            with torch.no_grad():
                val_loss = run_epoch(
                    model=model,
                    loader=val_loader,
                    criterion=criterion,
                    device=device,
                    optimizer=None,
                    scaler=scaler,
                    scheduler=None,
                    use_amp=use_amp,
                    channels_last=channels_last,
                    epoch=epoch,
                    total_epochs=args.epochs,
                    log_interval=args.log_interval,
                    accumulation_steps=1,
                )

            if device.type == "cuda":
                torch.cuda.synchronize(device)

            validation_seconds = time.perf_counter() - validation_start

            current_lr = float(optimizer.param_groups[0]["lr"])
            epoch_seconds = time.perf_counter() - epoch_start

            peak_memory_mb = 0.0
            if device.type == "cuda":
                peak_memory_mb = torch.cuda.max_memory_allocated(device) / (1024 ** 2)
                torch.cuda.empty_cache()

            if val_loss < best_val_loss:
                best_val_loss = val_loss
                best_epoch = epoch

            row = {
                "epoch": epoch,
                "train_loss": train_loss,
                "val_loss": val_loss,
                "learning_rate": current_lr,
                "epoch_seconds": epoch_seconds,
                "train_seconds": train_seconds,
                "validation_seconds": validation_seconds,
                "peak_gpu_memory_mb": peak_memory_mb,
            }

            history.append(row)
            save_history(history, output_dir)
            save_plots(history, output_dir)

            save_checkpoint(
                path=latest_checkpoint_path,
                model=model,
                optimizer=optimizer,
                scaler=scaler,
                epoch=epoch,
                train_loss=train_loss,
                val_loss=val_loss,
                seed=args.seed,
                best_val_loss=best_val_loss,
                best_epoch=best_epoch,
                config=config,
                scheduler=scheduler,
            )

            if epoch == best_epoch:
                save_checkpoint(
                    path=checkpoint_path,
                    model=model,
                    optimizer=optimizer,
                    scaler=scaler,
                    epoch=epoch,
                    train_loss=train_loss,
                    val_loss=val_loss,
                    seed=args.seed,
                    best_val_loss=best_val_loss,
                    best_epoch=best_epoch,
                    config=config,
                    scheduler=scheduler,
                )
                print(f"Saved best checkpoint: {checkpoint_path}")

            save_summary(
                history=history,
                output_dir=output_dir,
                best_epoch=best_epoch,
                best_val_loss=best_val_loss,
                checkpoint_path=checkpoint_path,
                latest_checkpoint_path=latest_checkpoint_path,
            )

            print(
                f"\nEpoch {epoch:03d}/{args.epochs:03d} | "
                f"Train loss: {train_loss:.6f} | "
                f"Validation loss: {val_loss:.6f} | "
                f"LR: {current_lr:.2e} | "
                f"Train: {train_seconds:.1f}s | "
                f"Validation: {validation_seconds:.1f}s | "
                f"Epoch: {epoch_seconds:.1f}s"
            )
            if device.type == "cuda":
                print(f"Peak allocated GPU memory: {peak_memory_mb:.1f} MiB")
            print(f"History saved to: {history_path}\n")

    except KeyboardInterrupt:
        print("\nTraining interrupted by user.")
        if history:
            save_history(history, output_dir)
            save_plots(history, output_dir)
            save_summary(
                history=history,
                output_dir=output_dir,
                best_epoch=best_epoch,
                best_val_loss=best_val_loss,
                checkpoint_path=checkpoint_path,
                latest_checkpoint_path=latest_checkpoint_path,
            )
        print("Completed epochs have been recorded. Resume with --resume.")
        return

    print("=" * 68)
    print("TRAINING COMPLETE")
    print("=" * 68)


def parse_args():
    parser = argparse.ArgumentParser(
        description="Train a lightweight segmentation CNN with hybrid loss and custom output directory."
    )

    parser.add_argument("--data", type=str, default="data")
    parser.add_argument(
        "--checkpoint", type=str, default="model_best.pt",
        help="Filename for the best-validation-loss checkpoint inside output-dir.",
    )
    parser.add_argument(
        "--latest-checkpoint", type=str, default="model_latest.pt",
        help="Filename for the most recently completed epoch inside output-dir.",
    )
    parser.add_argument(
        "--output-dir", type=str, default="experiments/model_hybrid_run",
        help="Directory for history, configuration, plots, summary, and checkpoints.",
    )
    parser.add_argument("--epochs", type=int, default=75)

    parser.add_argument("--batch-size", type=int, default=16, help="Micro-batch size for GPU memory")
    parser.add_argument("--accumulation-steps", type=int, default=4, help="Number of steps to accumulate gradients")

    parser.add_argument("--learning-rate", type=float, default=1e-3)
    parser.add_argument("--weight-decay", type=float, default=1e-4)
    parser.add_argument("--seed", type=int, default=42)

    parser.add_argument("--device", choices=["auto", "cpu", "cuda"], default="auto")
    parser.add_argument(
        "--workers", type=int, default=4,
        help="Number of CPU workers for image loading.",
    )
    parser.add_argument("--limit", type=int, default=None, help="Limit dataset size for smoke tests.")
    parser.add_argument("--log-interval", type=int, default=25, help="Update progress-bar loss every N batches.")

    parser.add_argument(
        "--amp", action=argparse.BooleanOptionalAction, default=True,
        help="Enable CUDA automatic mixed precision when available.",
    )
    parser.add_argument(
        "--channels-last", action=argparse.BooleanOptionalAction, default=True,
        help="Use channels-last memory format on CUDA.",
    )
    parser.add_argument(
        "--compile", action=argparse.BooleanOptionalAction, default=False,
        help="Enable PyTorch 2.0 torch.compile() for speed up.",
    )
    parser.add_argument(
        "--min-learning-rate", type=float, default=1e-6,
        help="Lower bound for the learning rate.",
    )

    parser.add_argument("--resume", action="store_true", help="Resume training from --resume-from.")
    parser.add_argument(
        "--resume-from", type=str, default="experiments/model_hybrid_run/model_latest.pt",
        help="Checkpoint path used when --resume is specified.",
    )
    parser.add_argument(
        "--overwrite-history", action="store_true",
        help="Start a fresh run and replace existing history files.",
    )

    args = parser.parse_args()

    if args.epochs < 1: parser.error("--epochs must be at least 1")
    if args.batch_size < 1: parser.error("--batch-size must be at least 1")
    if args.accumulation_steps < 1: parser.error("--accumulation-steps must be at least 1")
    if args.learning_rate <= 0: parser.error("--learning-rate must be positive")
    if args.weight_decay < 0: parser.error("--weight-decay cannot be negative")
    if args.workers < 0: parser.error("--workers cannot be negative")
    if args.log_interval < 1: parser.error("--log-interval must be at least 1")
    if args.limit is not None and args.limit < 2: parser.error("--limit must be at least 2")
    if args.min_learning_rate <= 0: parser.error("--min-learning-rate must be positive")

    return args


if __name__ == "__main__":
    train(parse_args())
